# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reliefflow

# MongoDB connection string and database name
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=reliefflow

## Legacy signing secret is unnecessary: authentication uses opaque database sessions.


# Defaults to true for production HTTPS. Use false only for local HTTP.
COOKIE_SECURE=false
# Administrator provisioning reads ADMIN_EMAIL and ADMIN_PASSWORD from process environment.

