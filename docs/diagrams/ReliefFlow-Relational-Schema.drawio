n/severity/timestamps; enum values and string/coordinate bounds. Existing documents are preserved with moderate validation." style="html=1;whiteSpace=wrap;fontFamily=Arial;text;strokeColor=none;fillColor=none;fontSize=20;fontColor=#526276;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="330" y="1450" width="2800" height="110" as="geometry" /></mxCell><mxCell id="n25" value="MongoDB is intentionally not represented as a PostgreSQL table • reference checks happen in /api/incidents" style="html=1;whiteSpace=wrap;fontFamily=Arial;text;strokeColor=none;fillColor=none;fontSize=17;fontColor=#526276;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="1805" width="3460" height="65" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>